{
  "expo": {
    "name": "家庭化学品安全检查",
    "slug": "home-chemical-safety-check",
    "version": "1.0.1",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "允许家庭化学品库使用相机拍摄产品标签",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许家庭化学品库选择产品照片用于识别和入库",
          "cameraPermission": "允许家庭化学品库使用相机拍摄产品标签",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "允许家庭化学品库访问照片，以保存产品封面图片",
          "savePhotosPermission": "允许家庭化学品库将产品封面图片保存到相册",
          "granularPermissions": ["photo"]
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.homechem.safety",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
