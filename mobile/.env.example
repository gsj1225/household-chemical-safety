# 后端 API 地址（末尾不带斜杠）
# 本地开发（后端跑在本机）：http://127.0.0.1:8000/api
# 局域网真机调试：http://<电脑局域网IP>:8000/api
# 演示环境（Tailscale 私网）：https://homechem-api.tailb5ce75.ts.net/api
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api

# 演示访问令牌，需与后端 backend/.env 的 DEMO_ACCESS_TOKEN 一致
# 后端 DEBUG=false 时必填，否则 API 返回 401
# 注意：EXPO_PUBLIC_* 变量会内联进客户端包，不属于安全秘密
EXPO_PUBLIC_DEMO_ACCESS_TOKEN=
