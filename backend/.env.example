# 排雷挑战 - 环境变量配置
# 复制此文件为 .env 并修改对应值

# AI 提供者：mock（本地演示）/ qwen（真实识别）
AI_PROVIDER=mock

# 应用配置
DEBUG=true
HOST=0.0.0.0
PORT=8000
MAX_IMAGE_SIZE_MB=5
CHALLENGE_TTL_SECONDS=3600
MAX_ACTIVE_CHALLENGES=1000
DATABASE_PATH=data/challenges.db
LOG_LEVEL=INFO
MAX_SCANS_PER_CHALLENGE=20
RATE_LIMIT_START_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_NARRATION_PER_MINUTE=60

# 生产环境请设置明确域名，例如：https://demo.example.com
CORS_ORIGINS=["*"]

# Qwen OpenAI-compatible API 配置（仅后端使用，绝不能提交真实密钥）
# QWEN_API_KEY=replace-with-a-new-local-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-flash
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=1
