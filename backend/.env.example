# 家庭化学品库 - 环境变量配置
# 复制此文件为 .env 并修改对应值
#
# ⚠️ 正式问答必须使用真实 Qwen（AI_PROVIDER=qwen）。
# MockAI / fake_search 仅允许通过单元测试依赖注入（test_mock_mode.py），
# 严禁通过复制本模板后得到 Mock 问答链路。
# 复制本文件为 .env 后，必须填入真实 QWEN_API_KEY 与 DEMO_ACCESS_TOKEN 才能启动正式问答。

# AI 提供者：仅支持真实 Qwen。生产/演示一律使用 qwen。
# 禁止设为 mock（Mock 仅存在于单元测试注入，不用于任何运行/演示环境）。
AI_PROVIDER=qwen

# 应用配置
# DEBUG=false 为生产/演示安全默认值（禁用 CORS 通配符、强制鉴权、强制真实 Qwen）。
# 如需本地联调可自行改为 DEBUG=true，但正式问答仍必须是真实 Qwen。
DEBUG=false
HOST=0.0.0.0
PORT=8000
MAX_IMAGE_SIZE_MB=5
DATABASE_PATH=data/inventory.db
LOG_LEVEL=INFO

# CORS
# DEBUG=true 时允许 ["*"]
# DEBUG=false 时禁止 ["*"]，原生 APK 用 []，Web QA 用明确 Origin
CORS_ORIGINS=[]

# 演示访问令牌（仅用于比赛演示，支持随时轮换）
# 设置后所有 /api 请求需携带 Authorization: Bearer <token>
# 留空则不启用鉴权（仅开发环境）
# DEBUG=false 时必须非空，否则启动失败
# 生成随机令牌：python -c "import secrets; print(secrets.token_urlsafe(24))"
# 请自行填入真实令牌，禁止提交真实值
DEMO_ACCESS_TOKEN=

# 识别接口限流（独立于通用限流）
RECOGNITION_RATE_LIMIT_PER_MINUTE=10

# 限流
RATE_LIMIT_START_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_NARRATION_PER_MINUTE=60

# Qwen OpenAI-compatible API 配置（仅后端使用，绝不能提交真实密钥）
# 正式问答必须配置真实 QWEN_API_KEY；留空时后端会明确报错，绝不静默回退 Mock。
# 复制本模板后请将下方密钥占位替换为真实 Key（不要提交真实值）。
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-flash
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=1
