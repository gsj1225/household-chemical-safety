# 家庭化学品库 — 部署环境变量模板
#
# 复制为 backend/.env 并填入实际值
# 注意：此文件包含敏感信息，禁止提交到 Git

# ── AI 配置 ──────────────────────────────────────
# mock: 本地预设识别 / qwen: 真实 Qwen API
AI_PROVIDER=qwen
QWEN_API_KEY=替换为真实密钥
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VL_MODEL=qwen3-vl-plus
QWEN_TEXT_MODEL=qwen-flash
QWEN_TIMEOUT_SECONDS=30
QWEN_MAX_RETRIES=1

# ── 应用配置 ──────────────────────────────────────
DEBUG=false
HOST=0.0.0.0
PORT=8000
MAX_IMAGE_SIZE_MB=5
DATABASE_PATH=data/inventory.db
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────
# DEBUG=false 时禁止使用 ["*"]
# 原生 APK 无 Origin 头，设为空列表即可：CORS_ORIGINS=[]
# 如需 Web QA 访问，添加真实 Origin：
# CORS_ORIGINS=["https://你的域名"]
CORS_ORIGINS=[]

# ── 演示访问令牌 ──────────────────────────────────
# 设置后所有 /api 请求需携带 Authorization: Bearer <token>
# 留空则不启用鉴权（仅开发环境）
# 生成随机令牌：python -c "import secrets; print(secrets.token_urlsafe(24))"
DEMO_ACCESS_TOKEN=

# ── 限流 ──────────────────────────────────────────
RATE_LIMIT_START_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=30
RATE_LIMIT_NARRATION_PER_MINUTE=60
RECOGNITION_RATE_LIMIT_PER_MINUTE=10
